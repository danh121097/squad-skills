.DS_Store
coverage/
dist/
*.tgz
node_modules/
*.log
*.tsbuildinfo
.env*
!.env.example

# Keep this pnpm-only repository free of other package-manager locks.
bun.lock
package-lock.json
yarn.lock

# Local Skills CLI installation outputs belong to consumers, not this catalog.
.agents/
.claude/
.cursor/
.opencode/
skills-lock.json

pnpm-debug.log*

# Local AgentKit execution records are not repository documentation. The
# feedback loop is the narrow exception: its inbox and weekly reports contain
# only redacted, publication-safe evidence that should survive across machines.
plans/*
!plans/feedback/
!plans/feedback/**
plans/feedback/private/

# Candidate evaluation runs are generated artifacts, never repository state.
.eval-runs/
